node_modules/
dist/
.env
.env.*
!.env.example
*.db
*.db-wal
*.db-shm
data/
# why: the vendored airports and metro datasets are committed (WP3, spec §7); `data/` above is the runtime volume
!packages/db/data/
.memsearch/
packages/providers/fixtures/recorded/**/*.raw.json
backups/
*.db*
reports/
# why: anchored, because an unanchored `coverage/` also ignored the source directory packages/core/src/coverage/ (WP1)
/coverage/
packages/*/coverage/
apps/*/coverage/
.stryker-tmp/
.worktrees/
.superpowers/
# raw vendor bodies written beside recorded fixtures (sec-008); never committed, wherever a recorded root lives
**/fixtures/recorded/**/*.raw.json

# why: recorded vendor responses (Google-Flights-derived SearchApi results, Aviasales cache) may not be
# republished, so they never enter git. They live on the developer's disk only; the parameter allowlists
# (params-*.json, our own derived data) and .gitkeep stay tracked. Plan decision 61.
packages/providers/fixtures/recorded/**/*.json
!packages/providers/fixtures/recorded/**/params-*.json
