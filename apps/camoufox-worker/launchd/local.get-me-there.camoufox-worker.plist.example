<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The camoufox worker as a launchd agent (docs/setup.md section 14; brief Task 14.5). Copy it to
  ~/Library/LaunchAgents/local.get-me-there.camoufox-worker.plist, replace /PATH/TO/get-me-there with your
  checkout and /Users/YOU with your home, then: launchctl bootstrap gui/$(id -u) <that plist>.
  No secret lives here: the key stays in ~/.local/state/get-me-there/camoufox/worker.env (0600), which run.ts loads.
  `env -i` empties the environment first, so nothing a login profile exports reaches the worker (run.ts refuses an
  inherited CAMOUFOX_* or DEBUG anyway); set PATH to where node and pnpm live on this Mac (`command -v pnpm`).
  A start-check failure exits 78; KeepAlive restarts only an unsuccessful exit, never faster than once a minute.
  Stop it with: launchctl bootout gui/$(id -u)/local.get-me-there.camoufox-worker
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.get-me-there.camoufox-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>-i</string>
    <string>HOME=/Users/YOU</string>
    <string>PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <string>TMPDIR=/tmp</string>
    <string>pnpm</string>
    <string>--dir</string>
    <string>/PATH/TO/get-me-there</string>
    <string>--filter</string>
    <string>@gmt/camoufox-worker</string>
    <string>start</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/PATH/TO/get-me-there</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/get-me-there/camoufox-worker.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/get-me-there/camoufox-worker.err.log</string>
</dict>
</plist>
