{
  "name": "@gmt/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@gmt/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/write-api-version.mjs dist/version.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --coverage",
    "dev": "node --conditions=@gmt/source --import tsx --watch src/bootstrap/start.ts",
    "tool": "node --conditions=@gmt/source --env-file-if-exists=../../.env --import tsx src/bootstrap/tool.ts",
    "start": "node dist/bootstrap/start.js",
    "mutate": "stryker run && node ../../scripts/mutation-gate.mjs reports/mutation/mutation.json"
  },
  "dependencies": {
    "@gmt/core": "workspace:*",
    "@gmt/db": "workspace:*",
    "@gmt/engine": "workspace:*",
    "@gmt/providers": "workspace:*",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "tsx": "4.23.15",
    "yaml": "2.9.1"
  }
}
