{
  "name": "@gmt/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@gmt/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --coverage",
    "dev": "tsx watch src/bootstrap/app.ts",
    "tool": "tsx src/bootstrap/tool.ts"
  },
  "dependencies": {
    "@gmt/core": "workspace:*",
    "@gmt/db": "workspace:*",
    "@gmt/engine": "workspace:*",
    "@gmt/providers": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@hono/zod-validator": "0.9.1",
    "hono": "4.13.13",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15"
  }
}
