{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "pnpm exec vitest run --coverage.enabled=false --bail=1 test/plan test/services test/setup test/exec test/commands test/real"
  },
  "mutate": [
    "src/plan/**/*.ts",
    "src/services/**/*.ts",
    "src/exec/system.ts",
    "src/setup/appEnv.ts",
    "src/setup/answers.ts",
    "src/setup/secrets.ts",
    "src/setup/importDb.ts",
    "src/setup/importDocker.ts",
    "src/commands/update.ts",
    "src/commands/restore.ts",
    "src/commands/uninstall.ts"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "reporters": ["html", "json", "progress"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "timeoutMS": 60000,
  "timeoutFactor": 3,
  "concurrency": 3,
  "ignorePatterns": ["dist", "/coverage", "reports"],
  "inPlace": false
}
