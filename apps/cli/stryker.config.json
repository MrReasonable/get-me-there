{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "pnpm exec vitest run --coverage.enabled=false test/plan test/services test/setup"
  },
  "mutate": ["src/plan/**/*.ts", "src/services/**/*.ts", "src/setup/answers.ts", "src/setup/secrets.ts"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "reporters": ["html", "json", "progress"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "timeoutMS": 60000,
  "timeoutFactor": 3,
  "concurrency": 2,
  "ignorePatterns": ["dist", "/coverage", "reports"],
  "inPlace": false
}
