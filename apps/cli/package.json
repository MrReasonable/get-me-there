{
  "name": "@gmt/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node ../../scripts/ensure-build.mjs && vitest run --coverage",
    "mutate": "node ../../scripts/ensure-build.mjs && stryker run && node ../../scripts/mutation-gate.mjs reports/mutation/mutation.json"
  },
  "dependencies": {
    "@gmt/core": "workspace:*",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "fast-check": "4.10.2",
    "tsx": "4.23.15"
  }
}
