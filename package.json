{
  "name": "get-me-there",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' --filter '!@gmt/camoufox-worker' build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "boundaries": "node scripts/check-boundaries.mjs",
    "casts": "node scripts/check-casts.mjs",
    "temp-dirs": "node scripts/check-temp-dirs.mjs",
    "test": "node scripts/ensure-build.mjs && vitest run",
    "test:coverage": "pnpm -r --workspace-concurrency=1 test",
    "mutate": "pnpm --filter @gmt/core mutate && pnpm --filter @gmt/engine mutate && pnpm --filter @gmt/api mutate && pnpm --filter @gmt/camoufox-worker mutate && pnpm --filter @gmt/cli mutate",
    "dev": "pnpm --parallel --filter @gmt/api --filter @gmt/web dev",
    "gmt": "node --conditions=@gmt/source --import tsx apps/cli/src/main.ts",
    "smoke:live": "pnpm -C apps/api run tool smoke",
    "record:fixtures": "pnpm -C apps/api run tool record",
    "secret-scan": "node scripts/secret-scan.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "minimatch": "10.2.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  }
}
