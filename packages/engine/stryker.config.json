{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "pnpm exec vitest run --coverage.enabled=false --bail=1 test/scheduler test/parse-cron.test.ts test/consentNotice.test.ts"
  },
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "mutate": [
    "src/scheduler/catchUp.ts",
    "src/scheduler/parseCron.ts",
    "src/scheduler/catchUpStart.ts",
    "src/scheduler/browserWindow.ts",
    "src/scheduler/heartbeat.ts",
    "src/tick.ts",
    "src/stages/browserGate.ts",
    "src/consentNotice.ts"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "reporters": ["html", "json", "progress"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "timeoutMS": 60000,
  "timeoutFactor": 3,
  "concurrency": 2,
  "ignorePatterns": ["dist", "/coverage", "reports"],
  "inPlace": false
}
