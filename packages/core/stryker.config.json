{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "pnpm exec vitest run --coverage.enabled=false"
  },
  "mutate": [
    "src/config/synthetic.ts",
    "src/labels/age.ts",
    "src/normalise/hashing.ts",
    "src/normalise/carrier.ts",
    "src/normalise/money.ts",
    "src/normalise/vendorUrl.ts",
    "src/constraints/*.ts",
    "src/selection/select.ts",
    "src/coverage/rollUp.ts",
    "src/alerts/dedup.ts"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "ignorePatterns": [
    "dist",
    "/coverage",
    "reports"
  ],
  "inPlace": true
}
