{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "pnpm exec vitest run --coverage.enabled=false"
  },
  "mutate": [
    "src/config/synthetic.ts",
    "src/labels/age.ts",
    "src/normalise/hashing.ts",
    "src/normalise/carrier.ts",
    "src/normalise/money.ts",
    "src/normalise/vendorUrl.ts",
    "src/constraints/*.ts",
    "src/selection/select.ts",
    "src/coverage/rollUp.ts",
    "src/alerts/dedup.ts",
    "src/alerts/evaluate.ts",
    "src/normalise/localTime.ts",
    "src/camoufox/builds.ts",
    "src/camoufox/protocol.ts",
    "src/camoufox/settings.ts",
    "src/camoufox/start.ts",
    "src/budget/window.ts",
    "src/local/movedMarker.ts",
    "src/local/paths.ts",
    "src/labels/skip.ts",
    "src/status/report.ts",
    "src/status/rules.ts",
    "src/status/time.ts"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "reporters": ["html", "json", "progress"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "timeoutMS": 60000,
  "timeoutFactor": 3,
  "concurrency": 2,
  "ignorePatterns": ["dist", "/coverage", "reports"],
  "inPlace": false
}
